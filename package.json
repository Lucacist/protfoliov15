  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true npm run build",
    "lint": "eslint",
    "test": "vitest run --exclude='**/smoke.test.ts'",
    "test:watch": "vitest --exclude='**/smoke.test.ts'",
    "test:unit": "vitest run __tests__/utils.test.ts __tests__/projects-data.test.ts",
    "test:smoke": "vitest run __tests__/smoke.test.ts",
    "validate": "vitest run __tests__/i18n.test.ts __tests__/project-integrity.test.ts",
    "check": "npm run lint && npm run validate && npm run test:unit",
    "check:all": "npm run build && npm run lint && npm test && npm run test:smoke"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
